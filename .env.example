APP_NAME="Giricahyo Carbon API"
APP_ENV=local
APP_KEY=
# WAJIB diubah saat deploy ke server:
#   APP_ENV=production
#   APP_DEBUG=false
# APP_DEBUG=true menampilkan seluruh jejak error — termasuk isi .env, kredensial
# database, dan JWT_SECRET — ke siapa pun yang memicu error di server.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Rincian waktu tiap permintaan di header Server-Timing (DevTools → Network →
# Timing). Nyalakan sementara saat menyelidiki kelambatan, lalu matikan lagi.
SERVER_TIMING=false

# WAJIB Asia/Jakarta, bukan UTC bawaan Laravel: dengan UTC, setiap hari
# antara 00:00-07:00 WIB "hari ini" menurut server masih kemarin.
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── MySQL — sesuaikan dengan konfigurasi server kampus ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=giricahyo_carbon
DB_USERNAME=root
DB_PASSWORD=

# ── JWT (generate dengan: php artisan jwt:secret) ──
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# ── CORS — izinkan frontend React ──
# Saat deploy, isi dengan domain frontend sebenarnya (mis. https://giricahyo.id).
# API HANYA melayani origin yang terdaftar di sini.
FRONTEND_URL=http://localhost:5173

# Opsional, dipisah koma — kalau frontend sah diakses dari lebih dari satu
# alamat, mis. saat uji lapangan dari ponsel lewat IP LAN:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.10:5173
# CORS_ALLOWED_ORIGINS=

BROADCAST_DRIVER=log
# CACHE_STORE, bukan CACHE_DRIVER — Laravel 11 mengganti nama kunci ini.
# Dengan nama lama, nilainya diabaikan diam-diam dan Laravel jatuh ke default
# `database`, sehingga rate limiter login menulis ke tabel `cache` MySQL pada
# SETIAP percobaan masuk: satu perjalanan ke database tambahan, dan login ikut
# gagal kalau MySQL sedang bermasalah. Dengan `file`, pembatasan laju cukup
# memakai berkas lokal.
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
